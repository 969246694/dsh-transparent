{
  "name": "dsh-transparent",
  "version": "1.4.5",
  "description": "Unofficial DSH desktop plugin: makes the window translucent so the desktop wallpaper shows through. Windows only. Also ships a genuinely refracting liquid-glass composer, though the app's layout keeps it barely visible.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "liquid-glass",
    "transparency",
    "windows"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.template.js",
    "dsh-transparent.css",
    "build.mjs",
    "verify.mjs",
    "cordis.patch.yml",
    "assets/window-glass.ps1",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "lib/vendor/"
  ],
  "scripts": {
    "build": "node build.mjs",
    "verify": "node verify.mjs",
    "test": "node build.mjs && node verify.mjs",
    "prepublishOnly": "node build.mjs && node verify.mjs"
  },
  "dependencies": {},
  "peerDependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "title": {
        "en": "Transparent Window",
        "zh": "窗口透明"
      }
    }
  },
  "repository": {
    "url": "git+https://github.com/969246694/dsh-transparent.git",
    "type": "git"
  },
  "homepage": "https://github.com/969246694/dsh-transparent#readme",
  "bugs": {
    "url": "https://github.com/969246694/dsh-transparent/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
